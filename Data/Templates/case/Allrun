fi

%:False
%{%(dynamicMeshEnabled%)
%:False
%{%(createPatchesForPeriodics%)
%:False
%{%(MovingMeshRegionsPresent%)
%:False
%{%(solver/SolverName%)
%:chtMultiRegionSimpleFoam chtMultiRegionFoam
%:default
# Mesh renumbering
runCommand renumberMesh -overwrite
%}
%}
