#includeIfPresent "fvOptionsScalarTransport"

%{%(meanVelocityForceEnabled%)
%:True
%{%(meanVelocityForce/VelocityProfileTemplate%)
%:Sine
momentumSource
{
    type            vectorCodedSource;
    selectionMode   all;
    active          yes;
    name            momentumSource;

    vectorCodedSourceCoeffs
    {
        selectionMode   all;
        fields          (U);

        codeInclude
        #{
            #include "mathematicalConstants.H"
        #};

        codeCorrect
        #{
            const vector averageVelocity(%(meanVelocityForce/SineAverageVelocityCpp%));
            const vector peakVelocity(%(meanVelocityForce/SinePeakVelocityCpp%));
            const scalar frequency = %(meanVelocityForce/SineFrequency%);

            const scalar t = mesh_.time().value();
            const vector target =
                averageVelocity
              + peakVelocity
              * Foam::sin
                (
                    2.0
                  * Foam::constant::mathematical::pi
                  * frequency
                  * t
                );

            vector sumVolU = vector::zero;
            scalar sumVol = 0.0;

            const scalarField& V = mesh_.V();
            forAll(cells_, i)
            {
                const label celli = cells_[i];
                const scalar vol = V[celli];
                sumVolU += fld[celli]*vol;
                sumVol += vol;
            }

            reduce(sumVolU, sumOp<vector>());
            reduce(sumVol, sumOp<scalar>());

            const vector current = sumVolU/stabilise(sumVol, VSMALL);
            const vector delta = target - current;

            forAll(cells_, i)
            {
                fld[cells_[i]] += delta;
            }

            fld.correctBoundaryConditions();

            Info<< "momentumSource: target Ubar = " << target
                << ", uncorrected Ubar = " << current << endl;
        #};

        codeAddSup
        #{
            (void)fieldi;
        #};

        codeConstrain
        #{
            (void)fieldi;
        #};
    }
}

%:default
momentumSource
{
    type            meanVelocityForce;
    selectionMode   all;
    active          yes;
    meanVelocityForceCoeffs
    {
        selectionMode   all;
        cellZone        all; // for the foundation version
        fields          (U);
        direction       (%(meanVelocityForce/Direction%));
        Ubar            (%(meanVelocityForce/Ubar%));
        relaxation      %(meanVelocityForce/Relaxation%);
    }
}

%}
%}
