import FreeCAD as App

from CfdOF import CfdTools
from CfdOF.Solve import CfdFluidBoundary


def add_boundary(label, region_name, boundary_type, subtype, thermal_type, refs,
                 temperature="293 K", velocity=(0, 0, 0), master=False, partners=None):
    boundary = CfdFluidBoundary.makeCfdFluidBoundary()
    CfdTools.getActiveAnalysis().addObject(boundary)
    boundary.Label = label
    boundary.BoundaryType = boundary_type
    boundary.BoundarySubType = subtype
    boundary.ThermalBoundaryType = thermal_type
    boundary.Temperature = temperature
    boundary.Ux = "{} mm/s".format(velocity[0])
    boundary.Uy = "{} mm/s".format(velocity[1])
    boundary.Uz = "{} mm/s".format(velocity[2])
    boundary.TurbulenceIntensityPercentage = 1.0
    boundary.TurbulenceLengthScale = "10 mm"
    boundary.RegionName = region_name
    boundary.RegionCoupledMaster = master
    boundary.RegionCoupledPartners = partners or []
    boundary.RegionCoupledPartner = boundary.RegionCoupledPartners[0] if boundary.RegionCoupledPartners else ""
    boundary.ShapeRefs = refs
    return boundary


fluid = App.ActiveDocument.FluidRegion
solid = App.ActiveDocument.SolidRegion

add_boundary(
    "inlet",
    "FluidProperties",
    "inlet",
    "uniformVelocityInlet",
    "fixedValue",
    [(fluid, ("Face1",))],
    velocity=(100, 0, 0),
)
add_boundary(
    "outlet",
    "FluidProperties",
    "outlet",
    "staticPressureOutlet",
    "fixedValue",
    [(fluid, ("Face2",))],
)
add_boundary(
    "fluid_wall",
    "FluidProperties",
    "wall",
    "fixedWall",
    "zeroGradient",
    [(fluid, ("Face3", "Face4", "Face5"))],
)
add_boundary(
    "fluid_to_aluminium",
    "FluidProperties",
    "wall",
    "fixedWall",
    "zeroGradient",
    [(fluid, ("Face6",))],
    master=True,
    partners=["aluminium_to_fluid"],
)
add_boundary(
    "aluminium_to_fluid",
    "aluminium",
    "wall",
    "fixedWall",
    "zeroGradient",
    [(solid, ("Face5",))],
    master=False,
)
add_boundary(
    "heatsource",
    "aluminium",
    "wall",
    "fixedWall",
    "fixedValue",
    [(solid, ("Face6",))],
    temperature="393 K",
)
add_boundary(
    "solid_wall",
    "aluminium",
    "wall",
    "fixedWall",
    "zeroGradient",
    [(solid, ("Face1", "Face2", "Face3", "Face4"))],
)

App.ActiveDocument.recompute()
